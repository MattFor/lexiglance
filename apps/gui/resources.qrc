        <file alias="up.png">resources/up.png</file>
        <file alias="up@2x.png">resources/up@2x.png</file>
        <file alias="down.png">resources/down.png</file>
        <file alias="down@2x.png">resources/down@2x.png</file>
        <file alias="lexiglance.svg">../../data/icons/lexiglance.svg</file>
        <file alias="lexiglance.png">../../data/windows/lexiglance.png</file>
        <file alias="CHANGELOG.md">../../CHANGELOG.md</file>
