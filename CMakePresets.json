{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 28,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "debug",
            "displayName": "Debug",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "LEXIGLANCE_WARNINGS_AS_ERRORS": "ON"
            }
        },
        {
            "name": "release",
            "displayName": "Release (LTO)",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "release-native",
            "displayName": "Release tuned for this CPU",
            "inherits": "release",
            "cacheVariables": {
                "LEXIGLANCE_NATIVE": "ON"
            }
        },
        {
            "name": "asan",
            "displayName": "Debug with sanitizers",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "LEXIGLANCE_SANITIZE": "ON"
            }
        },
        {
            "name": "clang-release",
            "displayName": "Release (Clang)",
            "inherits": "release",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },
        {
            "name": "clang-asan",
            "displayName": "Debug with sanitizers (Clang, bundled runtime)",
            "inherits": "asan",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },
        {
            "name": "portable",
            "displayName": "Portable part only (core, lexiglancectl, settings app, tests)",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "LEXIGLANCE_BUILD_DAEMON": "OFF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "release",
            "configurePreset": "release"
        },
        {
            "name": "release-native",
            "configurePreset": "release-native"
        },
        {
            "name": "asan",
            "configurePreset": "asan"
        },
        {
            "name": "clang-release",
            "configurePreset": "clang-release"
        },
        {
            "name": "clang-asan",
            "configurePreset": "clang-asan"
        },
        {
            "name": "portable",
            "configurePreset": "portable"
        }
    ],
    "testPresets": [
        {
            "name": "debug",
            "configurePreset": "debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "release",
            "configurePreset": "release",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "asan",
            "configurePreset": "asan",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "clang-asan",
            "configurePreset": "clang-asan",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "portable",
            "configurePreset": "portable",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
