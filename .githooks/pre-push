#!/usr/bin/env bash
# Before a push: the version in CMakeLists.txt has to have gone up. The in-app updater, About and the release workflow
# know a release only by it, so one pushed without raising it is never offered as an update (the 1.3.2 hotfix went out
# still saying 1.3.1), and a release tag has to be exactly v<that version>.
#   Turned on once per clone:  git config core.hooksPath .githooks
#   Pushed anyway:             git push --no-verify
set -uo pipefail

remote="$1"
zero="$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')"

# The version at a commit: the first VERSION line of CMakeLists.txt that starts a line, which is project()'s
# (cmake_minimum_required's is on its own line).
version_at() {
    git show "$1:CMakeLists.txt" 2>/dev/null | sed -n 's/^[[:space:]]*VERSION[[:space:]]\{1,\}\([0-9][0-9.]*\).*$/\1/p' | head -n 1
}

# Whether version $1 comes after $2.
higher() {
    [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n 1)" = "$1" ]
}

# Releases are made from the remote's default branch; other branches are not checked.
default="$(git symbolic-ref -q --short "refs/remotes/$remote/HEAD" 2>/dev/null)"
default="${default#"$remote"/}"
default="${default:-master}"

problems=()
while read -r _ local_sha remote_ref remote_sha; do
    # Deleting something on the remote.
    [ "$local_sha" = "$zero" ] && continue
    case "$remote_ref" in
        refs/tags/v[0-9]*)
            tag="${remote_ref#refs/tags/}"
            version="$(version_at "$local_sha")"
            if [ "$tag" != "v$version" ]; then
                problems+=("the tag $tag is on a commit whose CMakeLists.txt says VERSION ${version:-(none)}, so that release would call itself ${version:-nothing}; tag it v$version, or raise the version first")
            fi
            ;;
        "refs/heads/$default")
            branch="$default"
            # What the remote has now: the commit this push replaces, else (not fetched yet) what this clone last saw.
            base=""
            if [ "$remote_sha" != "$zero" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
                base="$remote_sha"
            elif git rev-parse -q --verify "refs/remotes/$remote/$branch" >/dev/null; then
                base="refs/remotes/$remote/$branch"
            fi
            [ -n "$base" ] || continue
            ours="$(version_at "$local_sha")"
            theirs="$(version_at "$base")"
            [ -n "$ours" ] && [ -n "$theirs" ] || continue
            if ! higher "$ours" "$theirs"; then
                problems+=("$branch: CMakeLists.txt says VERSION $ours, and $remote already has $theirs; raise project(... VERSION ...) so the updater sees a new version")
            fi
            ;;
    esac
done

[ ${#problems[@]} -eq 0 ] && exit 0
{
    echo "warning: the version was not raised:"
    for problem in "${problems[@]}"; do
        echo "  - $problem"
    done
} >&2
# Asked at a terminal; where there is none (an IDE's push), the push stops.
if (exec </dev/tty) 2>/dev/null; then
    printf 'Push anyway? [y/N] ' >&2
    read -r answer </dev/tty || answer=""
    case "$answer" in
        [yY]*) exit 0 ;;
    esac
    echo "Not pushed." >&2
    exit 1
fi
echo "Not pushed. To push anyway: git push --no-verify" >&2
exit 1
