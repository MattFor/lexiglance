#ifndef LEXIGLANCE_LANGUAGE_BUILTINLANGUAGES_H
#define LEXIGLANCE_LANGUAGE_BUILTINLANGUAGES_H

#include <array>
#include <string_view>

// The files in data/languages, built into the program (generated by src/CMakeLists.txt).
namespace lexiglance::lang
{

	// clang-format off: the placeholder must stay intact for configure_file.
	inline constexpr auto builtin_languages = std::to_array<std::string_view>( {
		@LANGUAGE_FILES@
	} );
	// clang-format on

} // namespace lexiglance::lang

#endif // LEXIGLANCE_LANGUAGE_BUILTINLANGUAGES_H
